# Copy to web/.env.local. Leave the Supabase values as placeholders to run in demo mode.
NEXT_PUBLIC_APP_NAME="APIKUBO"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_GATEWAY_URL="http://localhost:8000"

# Supabase Auth & Database (client-safe anon key only; RLS enforces access)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# The web app never uses the service role key. It belongs to the gateway only (gateway/.env.example).

# Optional, server-only: GitHub token for the Trending page (raises search limit 10 -> 30 req/min).
# Create a fine-grained token with NO permissions (public data only). Never prefix with NEXT_PUBLIC_.
GITHUB_TOKEN=""
# Optional moderation for the Trending page: comma-separated GitHub/HF owners or owner/repo to hide.
DISCOVER_BLOCKLIST=""
