# APIKUBO Gateway — copy to gateway/.env and load with:  set -a; source .env; set +a
GATEWAY_ENV="development"            # "production" enforces Supabase + Redis + SSRF guard

# Supabase (service role bypasses RLS: SERVER-SIDE ONLY, never ship to a browser)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Rate limits & quotas. Unset = in-memory (single process, dev only)
REDIS_URL="redis://localhost:6379/0"

GATEWAY_UPSTREAM_TIMEOUT=30           # seconds
GATEWAY_MAX_BODY_BYTES=10485760       # 10 MB
GATEWAY_CACHE_TTL=15                  # seconds; how long key/subscription lookups are cached
GATEWAY_ALLOW_PRIVATE_UPSTREAMS=false # true only to proxy to localhost during development

# Local dev without Supabase: seeds listing "echo" and this key into the memory store
# Format: kubo_test_ + 43 chars [A-Za-z0-9_-]
GATEWAY_DEV_API_KEY=""
GATEWAY_DEV_UPSTREAM_URL="https://httpbin.org/anything"
